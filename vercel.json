{
  "version": 2,
  "builds": [
    {
      "src": "flood.py",
      "use": "@vercel/python"
    },
    {
      "src": "flood_map.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/flood_map.html"
    },
    {
      "src": "/flood/(.*)",
      "dest": "/$1"
    },
    {
      "src": "/api/flood",
      "dest": "/flood.py"
    }
  ]
}